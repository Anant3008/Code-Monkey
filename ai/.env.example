# ==============================================================================
# Semantic Chaos Monkey — Environment Configuration
# ==============================================================================

# --- Primary Configuration: DigitalOcean Serverless Inference (Open-Weight) ---
LLM_BASE_URL=https://inference.do-ai.run/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=your_digitalocean_model_access_key
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.4
CHAOS_FIXTURE_MODE=false

# --- Alternative Configuration: Local Ollama (Uncomment to use) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama
# CHAOS_FIXTURE_MODE=false

# --- Offline / Hackathon Testing Mode (No Network Access) ---
# Set to 'true' to serve deterministic fixtures instantly without API keys
# CHAOS_FIXTURE_MODE=true
