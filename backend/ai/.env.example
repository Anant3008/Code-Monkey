# Semantic Chaos Monkey - AI Module Configuration
# Open-Weight Inference Server (e.g. Ollama, vLLM, LM Studio, OpenRouter)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TIMEOUT=12.0

# Fixture / Offline Testing Mode
# Set to 'true' to run deterministically without calling a live LLM endpoint
CHAOS_FIXTURE_MODE=false
